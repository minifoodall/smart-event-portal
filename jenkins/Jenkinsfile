// Smart Event Management Portal — CI/CD Jenkinsfile
// Stages: Checkout → Setup → Test → Build Images → Trivy Scan → Push → Deploy → Verify → Rollback-on-fail
// Required Jenkins plugins: Git, Docker Pipeline, Pipeline, Blue Ocean, Kubernetes CLI, Credentials, AnsiColor, Timestamper
pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  environment {
    DOCKERHUB_USER   = 'gunjkushwaha'
    IMAGE_BACKEND    = "${DOCKERHUB_USER}/eventportal-backend"
    IMAGE_FRONTEND   = "${DOCKERHUB_USER}/eventportal-frontend"
    K8S_NAMESPACE    = 'event-portal'
    APP_VERSION      = "v${BUILD_NUMBER}"
    PREVIOUS_VERSION = 'v1'
  }

  parameters {
    choice(name: 'DEPLOY_ENV', choices: ['staging', 'production'], description: 'Target environment')
    booleanParam(name: 'TRIGGER_ROLLBACK', defaultValue: false, description: 'Force rollback to PREVIOUS_VERSION')
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log --oneline -5'
      }
    }

    stage('Setup Tools') {
      steps {
        sh '''
          echo "Node: $(node -v || true)"
          echo "NPM:  $(npm -v  || true)"
          echo "Docker: $(docker --version || true)"
          echo "kubectl: $(kubectl version --client --short 2>/dev/null || true)"
        '''
      }
    }

    stage('Test') {
      parallel {
        stage('Backend tests') {
          steps {
            dir('backend') {
              sh 'npm ci || npm install'
              sh 'npm test -- --watchAll=false || npm test --passWithNoTests'
            }
          }
        }
        stage('Frontend tests') {
          steps {
            dir('frontend') {
              sh 'npm ci || npm install'
              sh 'npm test -- --watchAll=false || npm test --passWithNoTests'
            }
          }
        }
      }
    }

    stage('Build & Tag Images') {
      steps {
        sh '''
          docker build -t ${IMAGE_BACKEND}:${APP_VERSION}   -t ${IMAGE_BACKEND}:latest   ./backend
          docker build -t ${IMAGE_FRONTEND}:${APP_VERSION} -t ${IMAGE_FRONTEND}:latest \
            --build-arg VITE_API_URL=/api --build-arg VITE_APP_VERSION=${APP_VERSION} \
            ./frontend
          docker images | grep eventportal
        '''
      }
    }

    stage('Trivy Security Scan') {
      steps {
        sh '''
          trivy image --severity HIGH,CRITICAL --no-progress ${IMAGE_BACKEND}:${APP_VERSION}  || true
          trivy image --severity HIGH,CRITICAL --no-progress ${IMAGE_FRONTEND}:${APP_VERSION} || true
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            docker push ${IMAGE_BACKEND}:${APP_VERSION}
            docker push ${IMAGE_BACKEND}:latest
            docker push ${IMAGE_FRONTEND}:${APP_VERSION}
            docker push ${IMAGE_FRONTEND}:latest
          '''
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        withKubeConfig([credentialsId: 'kubeconfig-creds']) {
          sh '''
            kubectl -n ${K8S_NAMESPACE} set image deployment/backend  backend=${IMAGE_BACKEND}:${APP_VERSION}  --record
            kubectl -n ${K8S_NAMESPACE} set image deployment/frontend frontend=${IMAGE_FRONTEND}:${APP_VERSION} --record
            kubectl -n ${K8S_NAMESPACE} rollout status deployment/backend  --timeout=3m
            kubectl -n ${K8S_NAMESPACE} rollout status deployment/frontend --timeout=3m
          '''
        }
      }
    }

    stage('Verify Deployment') {
      steps {
        sh '''
          sleep 10
          for i in 1 2 3 4 5; do
            code=$(curl -s -o /dev/null -w "%{http_code}" http://${K8S_NAMESPACE}.svc.cluster.local:80/api/health || echo 000)
            [ "$code" = "200" ] && { echo "Health OK"; exit 0; }
            echo "Try $i: $code"; sleep 5
          done
          echo "Health endpoint never returned 200"; exit 1
        '''
      }
    }
  }

  post {
    success {
      echo "✅ Deployment ${APP_VERSION} succeeded"
      withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
        sh "curl -fsS -X POST -H 'Content-Type: application/json' --data '{\"text\":\"✅ Smart Event Portal ${APP_VERSION} deployed to ${DEPLOY_ENV} by ${BUILD_USER}\"}' $SLACK_URL || true"
      }
    }
    failure {
      echo "❌ Pipeline failed — triggering automatic rollback"
      withKubeConfig([credentialsId: 'kubeconfig-creds']) {
        sh '''
          kubectl -n ${K8S_NAMESPACE} rollout undo deployment/backend
          kubectl -n ${K8S_NAMESPACE} rollout undo deployment/frontend
          kubectl -n ${K8S_NAMESPACE} rollout status deployment/backend  --timeout=3m
          kubectl -n ${K8S_NAMESPACE} rollout status deployment/frontend --timeout=3m
        '''
      }
      withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
        sh "curl -fsS -X POST -H 'Content-Type: application/json' --data '{\"text\":\"❌ Build #${BUILD_NUMBER} failed — rolled back ${APP_VERSION}\"}' $SLACK_URL || true"
      }
    }
    always {
      sh 'docker logout || true'
    }
  }
}
